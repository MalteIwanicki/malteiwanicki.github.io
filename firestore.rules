rules_version = '2';

// PRIVATE APP: only these verified Google accounts may read/write ANY data.
// Enforced server-side, so it cannot be bypassed from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             "iwanicki.rm@gmail.com",
             "malteiwa@gmail.com"
           ];
    }

    // Legacy per-user selection store (kept for the one-time migration).
    match /users/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }

    // Each user's PRIVATE recipe book (recipes + selected meals + the shared
    // shopping list). Owner-only: a user can never read or write anyone else's
    // book. Both partners sign in with the SAME allowlisted account, so they
    // share this one document and the shopping list syncs live between them.
    match /recipebooks/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }
  }
}
